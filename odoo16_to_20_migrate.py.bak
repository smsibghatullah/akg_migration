def canon(m):
    return "stock.route" if m in ("stock.location.route", "stock.route") else m


def m2o_id(x):
    """many2one value ([id, name] ya sirf id) se id"""
    return x[0] if isinstance(x, (list, tuple)) else x


# ----------------------------------------------------------------- connections
class Odoo:
    """Odoo 16 : XML-RPC"""
    def __init__(self, cfg):
        self.cfg = cfg
        common = xmlrpc.client.ServerProxy(cfg["url"] + "/xmlrpc/2/common", allow_none=True)
        self.uid = common.authenticate(cfg["db"], cfg["user"], cfg["password"], {})
        if not self.uid:
            raise SystemExit("Login fail: " + cfg["url"])
        self.obj = xmlrpc.client.ServerProxy(cfg["url"] + "/xmlrpc/2/object", allow_none=True)
        self._f, self.err = {}, {}

    def call(self, model, method, *args, **kw):
        return self.obj.execute_kw(self.cfg["db"], self.uid, self.cfg["password"], model, method, list(args), kw)

    def fields(self, model):
        if model not in self._f:
            try:
                self._f[model] = self.call(model, "fields_get", attributes=[
                    "type", "relation", "store", "readonly", "required", "selection",
                    "string", "company_dependent"])
            except Exception as e:
                self._f[model] = None
                self.err[model] = str(e)[:200]
        return self._f[model]


class Odoo2(Odoo):
    """Odoo 20 : JSON-2 API (POST /json/2/<model>/<method>, bearer API key)"""
    POS = {"search": ["domain"], "search_read": ["domain"], "search_count": ["domain"],
           "read": ["ids"], "write": ["ids", "vals"], "create": ["vals_list"], "unlink": ["ids"]}

    def __init__(self, cfg):
        self.cfg = cfg
        self._f, self.err = {}, {}
        self.call("res.users", "context_get")  # connection/API key test

    def call(self, model, method, *args, **kw):
        body = dict(kw)
        for n, v in zip(self.POS.get(method, []), args):
            body[n] = [v] if n == "vals_list" else v
        req = urllib.request.Request(
            "%s/json/2/%s/%s" % (self.cfg["url"], model, method),
            data=json.dumps(body).encode(), method="POST",
            headers={"Authorization": "bearer " + self.cfg["api_key"],
                     "X-Odoo-Database": self.cfg["db"],
                     "Content-Type": "application/json", "User-Agent": "akg-migration"})
        try:
            res = json.loads(urllib.request.urlopen(req, timeout=300).read().decode())
        except urllib.error.HTTPError as e:
            txt = e.read().decode(errors="replace")
            try:
                txt = json.loads(txt).get("message", txt)
            except Exception:
                pass
            raise RuntimeError("HTTP %s %s/%s: %s" % (e.code, model, method, str(txt)[:300]))
        if method == "create" and isinstance(res, list):
            return res[0]
        return res


