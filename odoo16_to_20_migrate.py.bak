#!/usr/bin/env python3
"""
Odoo 16 -> Odoo 20 MASTER DATA migration   (v2: field_diff.csv ke hisaab se)

Odoo 16  : XML-RPC (login + password)
Odoo 20  : JSON-2 API (API key)

Commands:
  python3 odoo16_to_20_migrate.py compare                  # field_diff.csv
  python3 odoo16_to_20_migrate.py inspect res.partner.bank hr.version   # inspect.txt (dst+src fields)
  python3 odoo16_to_20_migrate.py migrate --dry-run
  python3 odoo16_to_20_migrate.py migrate                  # normal steps (experimental steps skip)
  python3 odoo16_to_20_migrate.py migrate --only res.users,hr.employee
  python3 odoo16_to_20_migrate.py list                     # steps ki list (experimental mark ke saath)
  python3 odoo16_to_20_migrate.py opening --cutover 2026-09-30   # opening balances / open items ka report (read-only)
  python3 odoo16_to_20_migrate.py verify product.template [--names-file names.xlsx]   # sach mein dst mein hai ya nahi (archived/merge/naam)
  python3 odoo16_to_20_migrate.py unmerge product.template   # merge hue records alag karo (phir migrate dobara)
  python3 odoo16_to_20_migrate.py report product.template pos.config   # kaun se records nahi aye + wajah
  python3 odoo16_to_20_migrate.py scan                     # Odoo16 mein kaun sa data hai (transactional) -> scan_report.txt/csv

Files: idmap.json (old id -> new id), migration.log, unresolved.csv
Script re-runnable hai. PEHLE STAGING PAR CHALAO.
"""
