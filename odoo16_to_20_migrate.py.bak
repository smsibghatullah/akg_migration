def src_model(name):
    for c in (name, ALT_MODELS.get(name)):
        if c and src.fields(c) is not None:
            return c
    return None


def dst_model(name):
    for c in (name, ALT_MODELS.get(name)):
        if c and dst.fields(c) is not None:
            return c
    return None


# ----------------------------------------------------------------- helpers
_meta = {}


def model_meta(conn, model):
    """ir.model.fields se: computed aur related fields ki list"""
    key = (id(conn), model)
    if key not in _meta:
        try:
            rows = conn.call("ir.model.fields", "search_read", [("model", "=", model)],
                             fields=["name", "compute", "related"])
        except Exception as e:
            log.warning("ir.model.fields read fail (%s): %s", model, str(e)[:120])
            rows = []
        _meta[key] = {"computed": {r["name"] for r in rows if r.get("compute")},
                      "related": {r["name"] for r in rows if r.get("related")}}
    return _meta[key]


# create/write fail ho aur error mein ye keyword ho to wo field hata kar dobara koshish (value dropped_values.csv mein)
RETRY_DROP = [("vat", "vat"), ("barcode", "barcode"), ("uom_ids", "uom")]


def safe_call(dm, did, vals):
    """create/write; kuch aam constraint errors par (VAT, barcode, uom) wo field hata kar dobara koshish"""
    for attempt in range(4):
        try:
            if did:
                dst.call(dm, "write", [did], vals, context=CTX)
                return did
            return dst.call(dm, "create", vals, context=CTX)
        except RuntimeError as e:
            msg = str(e).lower()
            hit = next((f for f, kw in RETRY_DROP if f in vals and kw in msg), None)
            if not hit:
                raise
            v = vals.pop(hit)
            if hit == "vat":
                vals["comment"] = (vals.get("comment") or "") + "<p>VAT (invalid, import nahi hua): %s</p>" % v
            log.warning("%s '%s': %s=%r hata kar dobara koshish (error: %s)", dm, vals.get("name"), hit, v, str(e)[:120])
            new = not os.path.exists("dropped_values.csv")
            with open("dropped_values.csv", "a", newline="", encoding="utf-8") as fh:
                w = csv.writer(fh)
                if new:
                    w.writerow(["model", "name", "field", "value", "error"])
                w.writerow([dm, vals.get("name"), hit, v, str(e)[:200]])
    raise RuntimeError("safe_call: bar bar retry ke baad bhi fail")


# ----------------------------------------------------------------- id map
class IdMap:
    def __init__(self, path):
        self.path = path
        self.d = json.load(open(path)) if os.path.exists(path) else {}

    def get(self, model, sid):
        return self.d.get(model, {}).get(str(sid))

    def set(self, model, sid, did):
        self.d.setdefault(model, {})[str(sid)] = did

    def protected(self, dm):
        return self.d.setdefault("_protected", {}).setdefault(dm, [])

    def save(self):
        json.dump(self.d, open(self.path, "w"))


idmap = None
_xml_cache = {}
PENDING = []  # (dst_model, dst_id, dst_field, type, src_rel, src_value)


def xmlid_map(smodel):
    """Standard (module.xmlid) records ko src->dst map karta hai"""
    if smodel in _xml_cache:
        return _xml_cache[smodel]
    out = {}
    dmodel = dst_model(smodel)
    if dmodel and src.fields(smodel) is not None:
        s = src.call("ir.model.data", "search_read", [("model", "=", smodel)], fields=["module", "name", "res_id"])
        d = dst.call("ir.model.data", "search_read", [("model", "=", dmodel)], fields=["module", "name", "res_id"])
        dm = {(r["module"], r["name"]): r["res_id"] for r in d}
        out = {r["res_id"]: dm[(r["module"], r["name"])] for r in s if (r["module"], r["name"]) in dm}
    _xml_cache[smodel] = out
    return out


def resolve(smodel, sid):
    if not sid:
        return False
    v = idmap.get(smodel, sid)
    if v:
        return v
    v = xmlid_map(smodel).get(sid)
    if v:
        idmap.set(smodel, sid, v)
    return v


def dname(f, df, ren):
    if f in ren:
        return ren[f]
    if f in df:
        return f
    a = AUTO_RENAMES.get(f)
    return a if a in df else f


# ----------------------------------------------------------------- hooks  hook(vals, rec, later) -> vals | None
def h_account(vals, rec, later):
    # Odoo 16: deprecated -> Odoo 20: active ; company_id -> company_ids (required)
    if "deprecated" in rec and "active" in dst.fields("account.account"):
        vals["active"] = not rec["deprecated"]
    if "company_ids" in dst.fields("account.account") and rec.get("company_id"):
        c = resolve("res.company", m2o_id(rec["company_id"]))
        if c:
            vals["company_ids"] = [[6, 0, [c]]]
        else:
            log.error("account %s: company map nahi mili", rec.get("code"))
    return vals


_ref_uom = {}


def h_uom(vals, rec, later):
    # Odoo 20: category/uom_type khatam; relative_uom_id + relative_factor (required)
    if rec.get("uom_type") == "reference":
        vals["relative_factor"] = 1.0
    else:
        vals["relative_factor"] = rec.get("factor_inv") or 1.0
        cat = m2o_id(rec["category_id"])
        if cat not in _ref_uom:
            r = src.call("uom.uom", "search", [("category_id", "=", cat), ("uom_type", "=", "reference")],
                         limit=1, context=CTX)
            _ref_uom[cat] = r[0] if r else None
        c = resolve("uom.uom", _ref_uom[cat]) if _ref_uom[cat] else None
        if c:
            vals["relative_uom_id"] = c
    return vals


def post_calendar(rec, did):
    """Naya calendar default attendance lines ke saath banta hai -> unhe hata do (overlap error)"""
    done = idmap.d.setdefault("_cal_cleared", [])
    if did in done:
        return
    ids = dst.call("resource.calendar", "read", [did], fields=["attendance_ids"])[0]["attendance_ids"]
    if ids:
        am = idmap.d.get("resource.calendar.attendance", {})
        for k in [k for k, v in am.items() if v in ids]:
            am.pop(k)
        dst.call("resource.calendar", "write", [did], {"attendance_ids": [[5, 0, 0]]}, context=CTX)
    done.append(did)


def h_attendance(vals, rec, later):
    if rec.get("week_type") in ("1", 1):
        log.warning("attendance %s: 2-week calendar ka doosra hafta - Odoo20 mein 2-week mode nahi, skip", rec.get("id"))
        return None
    if "duration_based" in dst.fields("resource.calendar.attendance"):
        vals["duration_based"] = False
    return vals


